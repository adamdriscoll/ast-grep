            "command_elements",
            "command_invokation_operator",
            "command_name",
            "command_name_expr",
            "command_parameter",
            "comment",
            "comparison_argument_expression",
            "comparison_expression",
            "comparison_operator",
            "data_command",
            "data_commands_allowed",
            "data_commands_list",
            "data_name",
            "data_statement",
            "decimal_integer_literal",
            "dimension",
            "do_statement",
            "element_access",
            "else_clause",
            "elseif_clause",
            "elseif_clauses",
            "empty_statement",
            "enum_member",
            "enum_statement",
            "expandable_here_string_literal",
            "expandable_string_literal",
            "expression_with_unary_operator",
            "file_redirection_operator",
            "finally_clause",
            "flow_control_statement",
            "for_condition",
            "for_initializer",
            "for_iterator",
            "for_statement",
            "foreach_parameter",
            "foreach_statement",
            "format_argument_expression",
            "format_expression",
            "format_operator",
            "function_name",
            "function_parameter_declaration",
            "function_statement",
            "generic_token",
            "generic_type_arguments",
            "generic_type_name",
            "hash_entry",
            "hash_literal_body",
            "hash_literal_expression",
            "hexadecimal_integer_literal",
            "if_statement",
            "inlinescript_statement",
            "integer_literal",
            "invokation_expression",
            "invokation_foreach_expression",
            "key_expression",
            "label",
            "label_expression",
            "left_assignment_expression",
            "logical_argument_expression",
            "logical_expression",
            "member_access",
            "member_name",
            "merging_redirection_operator",
            "multiplicative_argument_expression",
            "multiplicative_expression",
            "named_block",
            "named_block_list",
            "parallel_statement",
            "param_block",
            "parameter_list",
            "parenthesized_expression",
            "path_command_name",
            "path_command_name_token",
            "pipeline",
            "pipeline_chain",
            "pipeline_chain_tail",
            "post_decrement_expression",
            "post_increment_expression",
            "pre_decrement_expression",
            "pre_increment_expression",
            "program",
            "range_argument_expression",
            "range_expression",
            "real_literal",
            "redirected_file_name",
